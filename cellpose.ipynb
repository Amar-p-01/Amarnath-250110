import os
from cellpose import models, train
from dsb_common import Dataset, report


def load_training_data(dataset):
    train_ids, val_ids = dataset.split()
    all_image_ids = sorted(train_ids + val_ids)

    images = []
    labels = []
    for img_id in all_image_ids:
        images.append(dataset.image(img_id))
        labels.append(dataset.labels(img_id))

    return images, labels


def main():
    finetune = False
    epochs = 30
    images_per_epoch = 200
    lr = 1e-5
    augment = False

    dataset = Dataset()
    ground_truth = dataset.test_ground_truth()

    model = models.CellposeModel(gpu=True)
    run_title = "Cellpose-SAM zero-shot"

    if finetune:
        run_title = "Cellpose-SAM fine-tuned"
        x_train, y_train = load_training_data(dataset)
        print(f"Fine-tuning on {len(x_train)} images...")

        save_directory = "./saved_models"
        os.makedirs(save_directory, exist_ok=True)

        trained_model_path, _, _ = train.train_seg(
            net=model.net,
            train_data=x_train,
            train_labels=y_train,
            batch_size=1,
            learning_rate=lr,
            weight_decay=0.1,
            n_epochs=epochs,
            nimg_per_epoch=images_per_epoch,
            min_train_masks=1,
            save_path=save_directory,
            model_name="cpsam_dsb",
        )
        print(f"Model saved to: {trained_model_path}")

        model = models.CellposeModel(gpu=True, pretrained_model=str(trained_model_path))

    print("Running evaluation on test set...")
    predictions = {}
    for image_id in ground_truth.keys():
        test_img = dataset.image(image_id, "test")
        output = model.eval(test_img, augment=augment)
        predictions[image_id] = output[0]

    report(dataset, predictions, ground_truth, run_title)


if __name__ == "__main__":
    main()
