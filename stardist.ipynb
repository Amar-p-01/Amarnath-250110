import numpy as np
from csbdeep.utils import normalize
from stardist import fill_label_holes
from stardist.models import Config2D, StarDist2D
from dsb_common import Dataset, report


def augmenter(image, labels):
    if np.random.rand() > 0.5:
        image, labels = image[::-1], labels[::-1]
    if np.random.rand() > 0.5:
        image, labels = image[:, ::-1], labels[:, ::-1]
    turns = np.random.randint(4)
    if turns:
        image = np.rot90(image, turns, (0, 1))
        labels = np.rot90(labels, turns, (0, 1))
    return np.ascontiguousarray(image), np.ascontiguousarray(labels)


def prepare_data(dataset, image_ids):
    images = []
    labels = []
    for img_id in image_ids:
        raw_img = dataset.image(img_id).astype(np.float32)
        norm_img = normalize(raw_img, 1, 99.8, axis=(0, 1))
        filled_labels = fill_label_holes(dataset.labels(img_id))
        images.append(norm_img)
        labels.append(filled_labels)
    return images, labels


def main():
    rays = 32
    grid = 1
    epochs = 200
    steps = 100
    batch_size = 4
    patch_size = 256
    depth = 4
    filters = 64

    dataset = Dataset()
    train_ids, holdout_ids = dataset.split()

    x_train, y_train = prepare_data(dataset, train_ids)
    x_holdout, y_holdout = prepare_data(dataset, holdout_ids)
    print(f"train {len(x_train)} holdout {len(x_holdout)}")

    repeats = {"fluorescence": 1, "histology": 2, "brightfield": 4}
    x_balanced = []
    y_balanced = []
    for img_id, img, lbl in zip(train_ids, x_train, y_train):
        repeat_count = repeats.get(dataset.modality[img_id], 1)
        for _ in range(repeat_count):
            x_balanced.append(img)
            y_balanced.append(lbl)
    print(f"balanced train {len(x_balanced)}")

    config = Config2D(
        n_rays=rays,
        grid=(grid, grid),
        n_channel_in=3,
        unet_n_depth=depth,
        unet_n_filter_base=filters,
        train_patch_size=(patch_size, patch_size),
        train_batch_size=batch_size,
        train_epochs=epochs,
        train_steps_per_epoch=steps,
        use_gpu=False,
    )
    model = StarDist2D(config, name="stardist_dsb", basedir="models")
    model.train(x_balanced, y_balanced, validation_data=(x_holdout, y_holdout), augmenter=augmenter)
    model.optimize_thresholds(x_holdout, y_holdout)

    truth = dataset.test_ground_truth()
    predictions = {}
    for image_id in truth.keys():
        test_img = dataset.image(image_id, "test").astype(np.float32)
        norm_test_img = normalize(test_img, 1, 99.8, axis=(0, 1))
        predictions[image_id] = model.predict_instances(norm_test_img)[0]

    report(dataset, predictions, truth, "StarDist")


if __name__ == "__main__":
    main()
